{
  "version": "P0.3.5-A3",
  "base_uri": "/api/v1/academy",
  "authentication": "auth_sessions opaque bearer token",
  "pagination": {"default": 50, "max": 100, "shape": ["data", "meta", "links"]},
  "concealment": {
    "sensitive": true,
    "internal_reasons": ["TARGET_NOT_FOUND", "NOT_AUTHORIZED", "OUT_OF_SCOPE", "CLASS_ASSIGNMENT_REQUIRED", "CONTEXT_MISMATCH", "INVALID_PERSON_REFERENCE"],
    "external_status": 404,
    "external_code": "RESOURCE_NOT_FOUND",
    "log_internal_reason": true
  },
  "endpoints": [
    {"method":"POST","uri":"programs/{program}/curricula","controller":"CurriculumController@store","service_operation":"CurriculumService::createVersion","permission":"ACADEMY_MANAGE","request":"ContextRequest","resource":"AcademyActionResource","success_status":201,"pagination":false,"sensitive_fields":["program.id"]},
    {"method":"POST","uri":"curricula/{curriculum}/publish","controller":"CurriculumController@publish","service_operation":"CurriculumService::publish","permission":"ACADEMY_MANAGE","request":"VersionedActionRequest","resource":"AcademyActionResource","success_status":200,"pagination":false,"sensitive_fields":[]},
    {"method":"POST","uri":"curricula/{curriculum}/courses","controller":"CurriculumController@addCourse","service_operation":"CurriculumService::addCourse","permission":"ACADEMY_MANAGE","request":"CurriculumCourseRequest","resource":"AcademyActionResource","success_status":201,"pagination":false,"sensitive_fields":[]},
    {"method":"POST","uri":"classes/{class}/enrollments","controller":"EnrollmentController@store","service_operation":"EnrollmentService::enroll","permission":"ACADEMY_ENROLL","request":"EnrollmentStoreRequest","resource":"EnrollmentResource","success_status":201,"pagination":false,"sensitive_fields":["person_id"]},
    {"method":"GET","uri":"classes/{class}/enrollments","controller":"EnrollmentController@index","service_operation":"EnrollmentService::listForClass","permission":"ACADEMY_VIEW","request":"AcademyListRequest","resource":"AcademyCollectionResource","success_status":200,"pagination":true,"sensitive_fields":["person_id"]},
    {"method":"POST","uri":"enrollments/{enrollment}/transitions","controller":"EnrollmentController@transition","service_operation":"EnrollmentService::transition","permission":"ACADEMY_ENROLL","request":"TransitionRequest","resource":"AcademyActionResource","success_status":200,"pagination":false,"sensitive_fields":[]},
    {"method":"POST","uri":"enrollments/{enrollment}/complete","controller":"EnrollmentController@complete","service_operation":"CompletionService::complete","permission":"ACADEMY_ASSESS","request":"VersionedActionRequest","resource":"AcademyActionResource","success_status":200,"pagination":false,"sensitive_fields":[]},
    {"method":"POST","uri":"classes/{class}/instructors","controller":"InstructorController@store","service_operation":"InstructorAssignmentService::assign","permission":"ACADEMY_MANAGE","request":"InstructorAssignRequest","resource":"AcademyActionResource","success_status":201,"pagination":false,"sensitive_fields":["person_id","source_document_id"]},
    {"method":"GET","uri":"classes/{class}/instructors","controller":"InstructorController@index","service_operation":"InstructorAssignmentService::activeAssignments","permission":"ACADEMY_VIEW","request":"ContextRequest","resource":"AcademyCollectionResource","success_status":200,"pagination":"bounded_200","sensitive_fields":["instructor_id"]},
    {"method":"POST","uri":"instructor-assignments/{assignment}/end","controller":"InstructorController@end","service_operation":"InstructorAssignmentService::end","permission":"ACADEMY_MANAGE","request":"VersionedActionRequest","resource":"AcademyActionResource","success_status":200,"pagination":false,"sensitive_fields":[]},
    {"method":"POST","uri":"classes/{class}/sessions","controller":"SessionController@store","service_operation":"ClassSessionService::schedule","permission":"ACADEMY_TEACH","request":"SessionStoreRequest","resource":"AcademyActionResource","success_status":201,"pagination":false,"sensitive_fields":[]},
    {"method":"POST","uri":"sessions/{session}/transitions","controller":"SessionController@transition","service_operation":"ClassSessionService::transition","permission":"ACADEMY_TEACH","request":"TransitionRequest","resource":"AcademyActionResource","success_status":200,"pagination":false,"sensitive_fields":[]},
    {"method":"GET","uri":"sessions/{session}/effective-location","controller":"SessionController@location","service_operation":"ClassSessionService::effectiveLocation","permission":"ACADEMY_VIEW","request":"ContextRequest","resource":"AcademyActionResource","success_status":200,"pagination":false,"sensitive_fields":[]},
    {"method":"PUT","uri":"sessions/{session}/attendance/{enrollment}","controller":"AttendanceController@store","service_operation":"AcademicAttendanceService::record","permission":"ACADEMY_ATTENDANCE","request":"AttendanceRecordRequest","resource":"AcademyActionResource","success_status":200,"pagination":false,"sensitive_fields":["recorded_by"]},
    {"method":"POST","uri":"sessions/{session}/attendance:bulk","controller":"AttendanceController@bulk","service_operation":"AcademicAttendanceService::recordBulk","permission":"ACADEMY_ATTENDANCE","request":"AttendanceBulkRequest","resource":"AcademyCollectionResource","success_status":200,"pagination":"max_200_items","sensitive_fields":["recorded_by"]},
    {"method":"GET","uri":"sessions/{session}/attendance","controller":"AttendanceController@index","service_operation":"AcademicAttendanceService::listForSession","permission":"ACADEMY_VIEW","request":"AcademyListRequest","resource":"AcademyCollectionResource","success_status":200,"pagination":true,"sensitive_fields":["recorded_by"]},
    {"method":"POST","uri":"course-versions/{courseVersion}/assessments","controller":"AssessmentController@store","service_operation":"AssessmentService::create","permission":"ACADEMY_MANAGE","request":"AssessmentStoreRequest","resource":"AcademyActionResource","success_status":201,"pagination":false,"sensitive_fields":[]},
    {"method":"PATCH","uri":"assessments/{assessment}","controller":"AssessmentController@update","service_operation":"AssessmentService::update","permission":"ACADEMY_MANAGE","request":"AssessmentUpdateRequest","resource":"AcademyActionResource","success_status":200,"pagination":false,"sensitive_fields":[]},
    {"method":"POST","uri":"assessments/{assessment}/attempts","controller":"AttemptController@store","service_operation":"AssessmentAttemptService::start","permission":"ACADEMY_ASSESS","request":"AttemptStoreRequest","resource":"AcademyActionResource","success_status":201,"pagination":false,"sensitive_fields":["answers_metadata"]},
    {"method":"POST","uri":"attempts/{attempt}/transitions","controller":"AttemptController@transition","service_operation":"AssessmentAttemptService::transition","permission":"ACADEMY_ASSESS","request":"TransitionRequest","resource":"AcademyActionResource","success_status":200,"pagination":false,"sensitive_fields":[]},
    {"method":"POST","uri":"attempts/{attempt}/grades","controller":"GradeController@store","service_operation":"GradeService::record","permission":"ACADEMY_ASSESS","request":"GradeStoreRequest","resource":"AcademyActionResource","success_status":201,"pagination":false,"sensitive_fields":["graded_by"]},
    {"method":"POST","uri":"attempts/{attempt}/grades/revisions","controller":"GradeController@revise","service_operation":"GradeService::revise","permission":"ACADEMY_ASSESS","request":"GradeRevisionRequest","resource":"AcademyActionResource","success_status":201,"pagination":false,"sensitive_fields":["graded_by"]},
    {"method":"POST","uri":"attempts/{attempt}/grades/finalize","controller":"GradeController@finalize","service_operation":"GradeService::finalize","permission":"ACADEMY_ASSESS","request":"VersionedActionRequest","resource":"AcademyActionResource","success_status":200,"pagination":false,"sensitive_fields":["graded_by"]},
    {"method":"GET","uri":"attempts/{attempt}/grades","controller":"GradeController@index","service_operation":"GradeService::history","permission":"ACADEMY_GRADES_VIEW","request":"ContextRequest","resource":"AcademyCollectionResource","success_status":200,"pagination":"bounded_by_attempt","sensitive_fields":["graded_by"]},
    {"method":"PUT","uri":"enrollments/{enrollment}/lessons/{lesson}/progress","controller":"ProgressController@lesson","service_operation":"ProgressService::recordLesson","permission":"ACADEMY_TEACH","request":"LessonProgressRequest","resource":"AcademyActionResource","success_status":200,"pagination":false,"sensitive_fields":[]},
    {"method":"PUT","uri":"enrollments/{enrollment}/resources/{resource}/progress","controller":"ProgressController@resource","service_operation":"ProgressService::recordResource","permission":"ACADEMY_TEACH","request":"ResourceProgressRequest","resource":"AcademyActionResource","success_status":200,"pagination":false,"sensitive_fields":[]},
    {"method":"POST","uri":"enrollments/{enrollment}/certificates","controller":"CertificateController@store","service_operation":"CertificateService::issue","permission":"ACADEMY_CERTIFY","request":"CertificateIssueRequest","resource":"CertificateResource","success_status":201,"pagination":false,"sensitive_fields":["file_id"]},
    {"method":"POST","uri":"certificates/{certificate}/revoke","controller":"CertificateController@revoke","service_operation":"CertificateService::revoke","permission":"ACADEMY_CERTIFY","request":"VersionedActionRequest","resource":"AcademyActionResource","success_status":200,"pagination":false,"sensitive_fields":[]},
    {"method":"POST","uri":"curricula/{curriculum}/people/{person}/transcript-preview","controller":"TranscriptController@preview","service_operation":"TranscriptService::compile","permission":"ACADEMY_GRADES_VIEW","request":"ContextRequest","resource":"TranscriptResource","success_status":200,"pagination":false,"sensitive_fields":["person_id","grades"]},
    {"method":"POST","uri":"curricula/{curriculum}/people/{person}/transcripts","controller":"TranscriptController@store","service_operation":"TranscriptService::issue","permission":"ACADEMY_CERTIFY","request":"TranscriptIssueRequest","resource":"TranscriptResource","success_status":201,"pagination":false,"sensitive_fields":["person_id","file_id","grades"]}
  ],
  "domain_error_mapping": {
    "TARGET_NOT_FOUND":"404 RESOURCE_NOT_FOUND","NOT_AUTHORIZED":"404 RESOURCE_NOT_FOUND","OUT_OF_SCOPE":"404 RESOURCE_NOT_FOUND","CLASS_ASSIGNMENT_REQUIRED":"404 RESOURCE_NOT_FOUND","ALREADY_ENROLLED":"409 ALREADY_ENROLLED","STALE_WRITE":"409 STALE_WRITE","POLICY_NOT_CONFIGURED":"422 ACADEMIC_POLICY_NOT_CONFIGURED","STATE_POLICY_PENDING":"422 STATE_POLICY_PENDING","CONSENT_REQUIRED":"422 PARTICIPATION_REQUIREMENTS_NOT_MET","CERTIFICATE_ALREADY_EXISTS":"409 CERTIFICATE_ALREADY_EXISTS","VALIDATION_ERROR":"422 VALIDATION_ERROR","CONFLICT":"409 CONFLICT"
  },
  "application_contract_conflicts": [
    "catalogue list/detail/create operations absent from approved A2 services",
    "safe minimal Person projection absent from the approved class roster service",
    "certificate/transcript persisted detail/list operations absent from approved A2 services"
  ]
}
